<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ColorOS 流体设计主题 -->
    <style name="Theme.ColorBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        
        <!-- 背景色（自适应深浅模式） -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- 透明状态栏 -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
    </style>
    
    <!-- 液态亚克力效果 -->
    <style name="GlassSurface">
        <item name="android:background">@drawable/glass_background</item>
        <item name="android:elevation">8dp</item>
    </style>
</resources>
